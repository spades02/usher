    "astro": "7.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.4",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "express": "5.1.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "usherjs": "workspace:*",
    "vitest": "3.2.4",
    "zod": "4.6.7"
