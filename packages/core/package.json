{
  "name": "usherjs",
  "version": "0.0.0",
  "description": "Let your customers bring their own AI agent.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "ai-agents",
    "chatgpt",
    "claude",
    "agent-auth"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": [
    "./dist/elements.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    }
  },
  "bin": {
    "usherjs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack --profile esm-only --quiet"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "express": "5.1.0",
    "happy-dom": "20.0.10",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "4.6.7"
  }
}
